usda.backbone <- subset(usda, acc==syn, select=c("Common.Name","Family", "taxon","auth","acc")) |> mutate(acgenus = extractTaxon(harmonize.taxa(taxon, fix = TRUE), 'genus'))
colnames(usda.backbone)
