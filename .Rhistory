veg <- vegnomods |> rbind(vegmods[,colnames(vegnomods)])
veg <- veg |> mutate(BA_count = BA, BA = ifelse(BA_Factor < 5, BA_Factor*BA_count, BA.to.SI(BA_Factor*BA_count)))
cover.agg0(veg$covO)
veg <- pre.fill.veg(veg, include=c("siteid","lat","lon","date","observer","state","county","plotsize",'BA_count','BA_Factor','Overstory','Understory','TotalVeg'), exclude=T)
veg <- veg |> mutate(covO = ifelse(stratum.min >= 5, cover,0),covU = ifelse(stratum.min <= 5, cover,0))
veg <- veg |> group_by(plot) |> mutate(covO1 = cover.agg0(covO), covU1 = cover.agg0(covU)) |> ungroup()
#transfer values to overstory cover if missing...
veg <- veg  |> mutate(Overstory = ifelse(is.na(Overstory) | Overstory == 0, covO1, Overstory),
Understory = ifelse(is.na(Understory)| Understory == 0, covU1, Understory))
#rescale if aggregate cover is significantly different from total cover
veg <- veg  |> group_by(plot) |> mutate(cover1O = rescale.cover0(covO,Overstory),
cover1U = rescale.cover0(covU,Understory)) |> ungroup()
veg <- veg  |> mutate(cover = ifelse(abs(Overstory-covO1) > 30 & cover1O > 0 & !is.nan(cover1O), cover1O, cover),
cover = ifelse(abs(Understory-covU1) > 30 & cover1U > 0 & !is.nan(cover1U), cover1U, cover))
veg$TotalVeg = apply(veg[,c('Overstory','Understory')], 1, cover.agg0)
veg <- pre.fill.veg(veg, include=c("plot","lat","lon","date","observer","state","county","plotsize",'BA_count','BA_Factor','Overstory','Understory','TotalVeg'), exclude=T)
preveg <- site |> left_join(spp) |> group_by(Observation_ID) |> mutate(alltallshrub = sum(TallShrub)) |> ungroup() |> mutate(nstrats = ifelse(is.na(alltallshrub) | (alltallshrub == 0 & !Observation_Type %in% c('DSP', 'USFS DSP')), 4,5)) |> group_by(Observation_ID, AcTaxon) |> mutate(BA = max(BA, na.rm=T),Dmin = max(Dmin, na.rm=T),Dmax = max(Dmax, na.rm=T)) |> ungroup()
preveg <- preveg |> mutate(plot=ifelse(!is.na(User_Plot_ID), User_Plot_ID,Observation_ID),
siteid = plot,
label = Observation_Label,
taxon = AcTaxon,
BA = ifelse(is.infinite(BA) | BA == 0,NA,BA),
Dmin = ifelse(is.infinite(Dmin),NA,Dmin),
Dmax = ifelse(is.infinite(Dmax),NA,Dmax))
dbh <- dbh |> left_join(preveg[!is.na(preveg$PlotPlant_ID),c('plot','taxon','PlotPlant_ID','BA','BA_Factor','Dmin','Dmax')]) |> mutate(height_m = ifelse(height_m == 0,NA, height_m)) |> subset(!is.na(taxon))
sdbh <- dbh |> group_by(plot,taxon) |> summarise(sDmin=min(diam_cm, na.rm=T),sDmax=max(diam_cm, na.rm=T),
sHmax=max(height_m, na.rm=T)) |> ungroup() |> mutate(sHmax= ifelse(is.infinite(sHmax),NA,sHmax))
preveg <- preveg |> left_join(sdbh)
preveg <- preveg |> mutate(Dmin = ifelse(is.na(Dmin), sDmin,Dmin),
Dmax = ifelse(is.na(Dmax), sDmax,Dmax))
preveg <- preveg  |> group_by(plot)  |> mutate(Hmax1 = max(sHmax, na.rm=T), Hmax2 = max(Tmax, na.rm=T),
Hmax1 = ifelse(is.infinite(Hmax1),NA,Hmax1),
Hmax2 = ifelse(is.infinite(Hmax2),NA,Hmax2),
Hmax = pmax(Hmax1,Hmax2, na.rm=T),
Hmax = ifelse(is.infinite(Hmax),NA,Hmax)) |> ungroup()
